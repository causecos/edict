# ── Edict 三省六部 事件驱动架构 ──
# 复制为 .env 并根据环境修改

# ── Postgres ──
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=edict
POSTGRES_USER=edict
POSTGRES_PASSWORD=CHANGE_ME

# ── Redis ──
REDIS_URL=redis://localhost:6379/0

# ── Backend ──
BACKEND_HOST=0.0.0.0
PORT=8000
API_KEY=CHANGE_ME
SECRET_KEY=CHANGE_ME
DEBUG=true

# ── 调度参数 ──
HEARTBEAT_INTERVAL_SEC=30
SCHEDULER_SCAN_INTERVAL_SECONDS=30

# ── 消息通知 ──
# DEFAULT_DISPATCH_CHANNEL 由 scripts/sync_agent_config.py 讀取
DEFAULT_DISPATCH_CHANNEL=telegram
