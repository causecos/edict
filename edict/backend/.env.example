# ══════════════════════════════════════════════════════════════
# 三省六部 · Edict 環境變數配置範例
# ══════════════════════════════════════════════════════════════
# 複製此檔案為 .env 並填入實際值：
#   cp .env.example .env
#
# 所有變數都有合理預設值，僅需修改密碼和連線資訊。
# 密碼類變數無預設值則以 secrets.token_urlsafe(32) 動態生成。
# ══════════════════════════════════════════════════════════════

# ── 資料庫 (PostgreSQL) ──
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=edict
POSTGRES_USER=edict
POSTGRES_PASSWORD=change_me

# 完整資料庫 URL（優先於上述元件，可覆蓋）
# DATABASE_URL=postgresql+asyncpg://edict:change_me@localhost:5432/edict

# ── 快取/訊息 (Redis) ──
REDIS_URL=redis://localhost:6379/0

# ── API 安全 ──
API_KEY=
SECRET_KEY=

# ── 伺服器 ──
BACKEND_HOST=0.0.0.0
PORT=8000
DEBUG=false

# ── 任務調度 ──
STALL_THRESHOLD_SEC=600
STALL_CHECK_INTERVAL_SEC=60
MAX_STALL_RETRIES=2
MAX_ESCALATION_LEVEL=3
STALL_RETRY_BACKOFF=[30, 60, 120]
DISPATCH_TIMEOUT_SEC=300
DISPATCH_MAX_RETRIES=3

# ── 心跳/定時 ──
HEARTBEAT_INTERVAL_SEC=30
SCHEDULER_SCAN_INTERVAL_SECONDS=30

# ── Dashboard（edict.sh 使用） ──
EDICT_DASHBOARD_PORT=7891
EDICT_BACKEND_PORT=8000
